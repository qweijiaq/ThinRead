{
  "name": "reading-notes",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "页边 · ThinRead — 本地优先的 AI 读书笔记应用",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron .",
    "screenshot": "pnpm build && electron . --screenshot=./screenshot.png",
    "test": "node scripts/run-tests.mjs",
    "test:ui": "pnpm build && node scripts/test-ui.mjs",
    "pack": "pnpm fetch:kokoro && pnpm build && electron-builder --dir",
    "dist:mac": "pnpm fetch:kokoro && pnpm build && electron-builder --mac",
    "test:e2e": "pnpm build && node scripts/test-e2e-real.mjs",
    "eval:real": "pnpm build && node scripts/eval-real.mjs",
    "test:ui:pdf": "pnpm build && node scripts/test-ui-pdf.mjs",
    "fetch:kokoro": "node scripts/fetch-kokoro.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "capture:storybook": "node scripts/capture-storybook.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@huggingface/transformers": "^4.3.2",
    "@lingo-reader/mobi-parser": "0.4.6",
    "@napi-rs/canvas": "^1.0.13",
    "@uzen/kokoro-js": "^1.2.4",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.0",
    "cheerio": "^1.0.0",
    "d3-force": "^3.0.0",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.2",
    "html-to-image": "1.11.13",
    "mermaid": "^12.2.0",
    "node-edge-tts": "^1.2.12",
    "pdfjs-dist": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.13.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.0",
    "storybook": "10.6.5",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qweijiaq/ThinRead.git"
  },
  "build": {
    "appId": "com.thinread.app",
    "productName": "ThinRead",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "*.swift"
        ]
      },
      {
        "from": "resources/kokoro",
        "to": "kokoro",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@napi-rs/canvas/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/pdfjs-dist/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "qweijiaq",
        "repo": "ThinRead"
      }
    ]
  },
  "author": "qweijiaq"
}
