{
  "name": "reading-notes",
  "version": "0.1.0",
  "private": true,
  "description": "页边 · ThinRead — 本地优先的 AI 读书笔记应用",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron .",
    "screenshot": "pnpm build && electron . --screenshot=./screenshot.png"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@huggingface/transformers": "^4.3.2",
    "@lingo-reader/mobi-parser": "0.4.6",
    "@napi-rs/canvas": "^1.0.13",
    "ai": "^7.0.0",
    "cheerio": "^1.0.0",
    "d3-force": "^3.0.0",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.13.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qweijiaq/ThinRead.git"
  }
}
